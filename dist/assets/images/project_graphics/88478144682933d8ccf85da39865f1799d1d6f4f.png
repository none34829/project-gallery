    <div class="news list columns:2 modifier:alternate" is="stanford-news">
     <ul class="cmp-list is-loading" id="news-f21928307c" data-link-items data-show-description data-show-image data-show-primarytag-date data-sort-articles-by="publishedDate">
      <li class="cmp-list__item" data-cf-path="/content/dam/content-fragments/sm/news/insights/2025/07/what-the-science-says--stanford-medicine-experts-break-it-down" data-tracking-topictags="Medical Research" data-tracking-primarytag="Medical Research" data-tracking-publishdate="2025-07-10T00:00:00+00:00" data-tags-count="1">
       <div class="teaser" is="stanford-teaser">
        <div class="cmp-teaser">
         <a aria-label="What The Science Says" class="cmp-teaser__link" href="https://med.stanford.edu/news/insights/2025/07/what-the-science-says--stanford-medicine-experts-break-it-down.html"></a>
         <div class="cmp-teaser__image">
          <div class="cmp-image">
           <a aria-label="What The Science Says" href="https://med.stanford.edu/news/insights/2025/07/what-the-science-says--stanford-medicine-experts-break-it-down.html">
            <div class="cmp-image">
             <div data-cmp-is="image" data-cmp-src="https://med.stanford.edu/news/insights/2025/07/what-the-science-says--stanford-medicine-experts-break-it-down/_jcr_content/_cq_featuredimage.coreimg{.width}.jpeg/1759714655947/whatthesciencesays.jpeg" data-asset-id="67fd659c-12d2-4961-a5db-6025d39ec49e" data-cmp-filereference="/content/dam/sm-news/images/2025/10/WhatTheScienceSays.jpeg" id="image-2b2826b66b" data-cmp-data-layer="{&quot;image-2b2826b66b&quot;:{&quot;@type&quot;:&quot;core/wcm/components/image/v3/image&quot;,&quot;dc:title&quot;:&quot;Creative Science Elements&quot;,&quot;image&quot;:{&quot;repo:id&quot;:&quot;67fd659c-12d2-4961-a5db-6025d39ec49e&quot;,&quot;repo:modifyDate&quot;:&quot;2025-10-06T01:37:35Z&quot;,&quot;@type&quot;:&quot;image/jpeg&quot;,&quot;repo:path&quot;:&quot;/content/dam/sm-news/images/2025/10/WhatTheScienceSays.jpeg&quot;}}}" data-cmp-hook-image="imageV3" class="cmp-image" itemscope itemtype="http://schema.org/ImageObject">
              <img src="https://med.stanford.edu/news/insights/2025/07/what-the-science-says--stanford-medicine-experts-break-it-down/_jcr_content/_cq_featuredimage.coreimg.jpeg/1759714655947/whatthesciencesays.jpeg" loading="eager" class="cmp-image__image" itemprop="contentUrl" width="2100" height="1485" alt="WhatTheScienceSays" title="Creative Science Elements" fetchpriority="high">
              <meta itemprop="caption" content="Creative Science Elements">
             </div>
            </div></a>
          </div>
         </div>
         <div class="cmp-teaser__content">
          <a class="cmp-teaser__publisher" aria-label="Insights" href="https://med.stanford.edu/news/insights.html"> Insights </a>
          <p class="cmp-teaser__publisher" aria-label="Insights">Insights</p>
          <div class="cmp-teaser__pretitle">
           <a class="tags" href="https://med.stanford.edu/news/topics/stanford-medicine/medical-research.html"> Medical Research </a> <span class="date"> July 10, 2025 </span>
          </div>
          <div class="cmp-teaser__title">
           What The Science Says
          </div>
          <div class="cmp-teaser__description">
           <p>Are there health and medical topics that seem shrouded in ambiguity? We've asked our Stanford Medicine experts to examine the scientific research in an effort to help fill in those information gaps.</p>
          </div>
         </div>
        </div>
       </div></li>
      <li class="cmp-list__item" data-cf-path="/content/dam/content-fragments/sm/news/insights/2025/07/paul-kalanithi-book-legacy-when-breath-becomes-air" data-tracking-topictags="stanford-medicine|Neurology &amp; Neurosurgery|Lung Cancer|Obituaries|Medical Research|Medical Education" data-tracking-primarytag="Cancer" data-tracking-publishdate="2025-07-08T00:00:00+00:00" data-tags-count="7">
