            <script>
        window.addEventListener('load', function() {

            function activateCookieyesIframes() {
                var consent = document.cookie.match(/functional:([^,;]+)/);
                document.querySelectorAll('iframe[data-cookieyes][data-src]').forEach(function(iframe) {
                    if (consent && consent[1] === 'yes') {
                        iframe.setAttribute('src', iframe.getAttribute('data-src'));
                        var placeholder = iframe.parentNode.querySelector('.cookieyes-placeholder');
                        if (placeholder) placeholder.remove();
                    } else {
                        if (!iframe.parentNode.querySelector('.cookieyes-placeholder')) {
                            var div = document.createElement('div');
                            div.className = 'cookieyes-placeholder';
                            div.innerHTML = '<figure><img src="https://cdn-cookieyes.com/assets/images/cky-placeholder.svg" /></figure><p>You have to accept cookies to access this content</p> <a class="button rounded small hover-transparent-black cky-banner-element">Cookie Settings</a>';
                            iframe.parentNode.insertBefore(div, iframe);
                        }
                    }
                });
            }

            function activateCookieyesScripts() {
                var consent = document.cookie.match(/analytics:([^,;]+)/);
                if (consent && consent[1] === 'yes') {
                    var alreadyLoaded = document.querySelector('script[src*="js.hsforms.net"]:not([type="text/plain"])');
                    if (alreadyLoaded) return;

                    var newScript = document.createElement('script');
                    newScript.src = 'https://js.hsforms.net/forms/embed/v2.js';
                    newScript.onload = function() {
                        window.dispatchEvent(new Event('hsFormsReady'));
                    };
                    document.head.appendChild(newScript);
                } else {
                    document.querySelectorAll('[class*="-target"]').forEach(function(el) {
                        if (!el.querySelector('.cookieyes-placeholder')) {
                            var div = document.createElement('div');
                            div.className = 'cookieyes-placeholder';
                            div.innerHTML = '<figure><img src="https://cdn-cookieyes.com/assets/images/cky-placeholder.svg" /></figure><p>You have to accept cookies to access this content</p> <a class="button rounded small hover-transparent-black cky-banner-element">Cookie Settings</a>';
                            el.appendChild(div);
                        }
                    });
                }
            }

            activateCookieyesIframes();
            activateCookieyesScripts();

            document.addEventListener('cookieyes_consent_update', function() {
                document.querySelectorAll('.cookieyes-placeholder').forEach(function(el) {
                    el.remove();
                });
                activateCookieyesIframes();
                activateCookieyesScripts();
            });

        });
    </script>
    <script>
        function replaceCkyPlaceholders() {
            document.querySelectorAll('[data-cky-tag="video-placeholder"]').forEach(function(el) {
                el.innerHTML = `
                <div class="cookieyes-placeholder"><figure><img src="https://cdn-cookieyes.com/assets/images/cky-placeholder.svg" /></figure>
                <p>You have to accept cookies to access this content</p>
                <a class="button rounded small hover-transparent-black cky-banner-element">Cookie Settings</a></div>
            `;
            });
        }

        // Evento nativo de CookieYes
        document.addEventListener('cky-consent-ready', replaceCkyPlaceholders);

        // Fallback por si el evento ya pasó
        window.addEventListener('load', function() {
            setTimeout(replaceCkyPlaceholders, 500);
        });
    </script>
